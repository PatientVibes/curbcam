# Copy to .env (gitignored) and uncomment what you need.
# curbcam reads CURBCAM_*-prefixed env vars; nested keys use __ (double underscore).

# Keep RTSP credentials out of curbcam.yaml by setting the camera source here:
# CURBCAM_CAMERA__SOURCE=rtsp://user:password@camera.local:554/stream

# Local timezone for container LOG timestamps only:
# TZ=America/Los_Angeles
#
# Note: the dashboard event feed shows times in your browser's timezone, while
# the Reports page and alert messages use the "Timezone" setting on the in-app
# Settings page (Settings -> Timezone, an IANA name like America/Los_Angeles).
# Set that so Reports and alerts match your local clock; leaving it blank = UTC.
